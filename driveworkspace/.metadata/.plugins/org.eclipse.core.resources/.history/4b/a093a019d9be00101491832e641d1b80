package ejerciciosControles;

import java.util.Scanner;

public class SolIncompleta202111 {

	public static void main(String[] args) {

		float[][] dineroTransferencias = new float[20][20];

		for (int i = 0; i < dineroTransferencias.length; i++) {
			for (int j = 0; j < dineroTransferencias[0].length; j++) {
				dineroTransferencias[i][j] = -1;
			}
		}
		Scanner sc = new Scanner(System.in);

		System.out.println("1- Introducir transferencia de una a otra sucursal.\r\n"
				+ "2- Mostrar todos los datos introducidos.\r\n"
				+ "3- Mostrar sucursal que ha recibido más dinero.\r\n"
				+ "4- Mostrar en cuántas sucursales el total de lo enviado supera 10.000€.\r\n" + "5- Finalizar.");
		int opcion = sc.nextInt();
		while (opcion < 5) {

			switch (opcion) {
			case 1:
				System.out.println("Suc envía");
				int sucEnvia = sc.nextInt();
				System.out.println("Suc recibe");
				int sucRecibe = sc.nextInt();

				System.out.println("Dinero que se transfiere");
				dineroTransferencias[sucEnvia][sucRecibe] = sc.nextFloat();

				break;
			case 2:
				for (int i = 0; i < dineroTransferencias.length; i++) {
					if (hayDatos(dineroTransferencias, i)) {
						System.out.println("La sucursal num. " + i + " ha enviado:");
						for (int j = 0; j < dineroTransferencias[0].length; j++) {
							if (dineroTransferencias[i][j] > -1) {
								System.out.println("\ta la sucursal " + j + ", " + dineroTransferencias[i][j] + "€");
							}
						}
					}
				}

				break;
			case 3:
				int sucursalMasRecibido = 0;
				float dineroMaximo = 0;
				for (int fila = 0; fila < dineroTransferencias.length; fila++) {
					if (hayDatos(dineroTransferencias, fila)) {
						for (int columna = 0; columna < dineroTransferencias[0].length; columna++) {
							float dineroRecibidoSucursal = 0;
							dineroRecibidoSucursal += dineroTransferencias[fila][columna];
							if (dineroRecibidoSucursal > dineroMaximo) {
								sucursalMasRecibido = fila;
								dineroMaximo = dineroRecibidoSucursal;
							}
						}
					}
				}
				System.out.println("La sucursal que mas dinero ha recibido es " + sucursalMasRecibido);
				break;
			case 4:
				int sucursalesSuperan10k = 0;
				for (int fila = 0; fila < dineroTransferencias.length; fila++) {
					if (hayDatos(dineroTransferencias, fila)) {
						float dineroTotalEnviado = 0;
						for (int columna = 0; columna < dineroTransferencias[0].length; columna++) {
							dineroTotalEnviado += dineroTransferencias[fila][columna];
							if (dineroTotalEnviado > 9999) {
								sucursalesSuperan10k++;
							}
						}
					}
				}
				System.out.println("El numero de sucursales que han recibido mas de 10.000 � es " + sucursalesSuperan10k);
				break;

			}

			System.out.println("1- Introducir transferencia de una a otra sucursal.\r\n"
					+ "2- Mostrar todos los datos introducidos.\r\n"
					+ "3- Mostrar sucursal que ha recibido más dinero.\r\n"
					+ "4- Mostrar en cuántas sucursales el total de lo enviado supera 10.000€.\r\n"
					+ "5- Finalizar.");
			opcion = sc.nextInt();
		}
		sc.close();
	}

	// devuelve true si hay datos en la fila "fila" de la matriz "matriz"
	public static boolean hayDatos(float[][] matriz, int fila) {
		boolean hay = false;

		for (int j = 0; j < matriz[0].length && !hay; j++) {
			if (matriz[fila][j] > -1) {
				hay = true;
			}
		}

		return hay;
	}

}

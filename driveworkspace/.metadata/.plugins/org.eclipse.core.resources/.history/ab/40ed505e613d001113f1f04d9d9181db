	public void borraPokemon(String pok) {
		Iterator<Pokemon> it = listaPokemons.iterator();
		Pokemon keyAborrar = null;
		while (it.hasNext()) {
			if (it.next().getNombre().equals(pok)) {
				it.remove();
				for (Pokemon p : this.combates.keySet()) {
					keyAborrar = p;
				}
			}
			this.combates.remove(keyAborrar);
		}
	}


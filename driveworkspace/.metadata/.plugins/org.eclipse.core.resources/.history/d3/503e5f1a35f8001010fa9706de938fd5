	public int totalUnidadesVendidas(Articulo Articulo) {
		int total = 0;
		/*
		 * This one is harder than it seems (It is not I am malding), but hear me out,
		 * we know articles have codes, I propose a solution we could go on each
		 * individual invoice, then to each individual line, and if the code of the
		 * article equals OUR article, we sum the quantity of items to the total,
		 * BOOM!!!
		 */
		for (int i = 0; i < tFacturas.length; i++) {
			for (int j = 0; j < tFacturas[i].gettLineas().length; j++) {
				if (tFacturas[i].gettLineas()[j].articulo.equals(Articulo)) {
					total += tFacturas[i].gettLineas()[j].cantidad;
				}
			}
		}
		return total;
	}


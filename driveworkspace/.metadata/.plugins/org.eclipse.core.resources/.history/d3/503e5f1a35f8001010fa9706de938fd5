	public ModeloDeDatos() {
		this.tArticulos = new Articulo[0];
		this.tClientes = new Cliente[0];
		this.tFacturas = new Factura[0];
	}

	public void anadeArticulo(Articulo ArticuloNuevo) {
		Articulo nuevaTArticulos[] = new Articulo[this.tArticulos.length + 1];
		for (int i = 0; i < this.tArticulos.length; i++)
			nuevaTArticulos[i] = tArticulos[i];

		nuevaTArticulos[this.tArticulos.length] = ArticuloNuevo;
		this.tArticulos = nuevaTArticulos;
	}

	public void anadeFactura(Factura FacturaNueva) {
		Factura nuevaTFacturas[] = new Factura[this.tFacturas.length + 1];
		for (int i = 0; i < this.tFacturas.length; i++)
			nuevaTFacturas[i] = tFacturas[i];

		nuevaTFacturas[this.tFacturas.length] = FacturaNueva;
		this.tFacturas = nuevaTFacturas;
	}

	public void anadeCliente(Cliente clienteNuevo) {
		Cliente nuevaTClientes[] = new Cliente[this.tClientes.length + 1];
		for (int i = 0; i < this.tClientes.length; i++)
			nuevaTClientes[i] = tClientes[i];

		nuevaTClientes[this.tClientes.length] = clienteNuevo;
		this.tClientes = nuevaTClientes;
	}

	public Factura facturaFusionada(Cliente cliente, int numFra) {
		Factura facturaFusionada = new Factura(numFra, cliente, 0);
		for (Factura f : tFacturas) {
			if (f.getCliente().equals(facturaFusionada.getCliente())) {
				for (Linea l : f.gettLineas()) {
					facturaFusionada.anadeLinea(new Linea(l.getArticulo(), l.getCantidad()));
				}
			}
		}
		return facturaFusionada;
	}

	public Factura facturaFusionadaResumida(Cliente cliente, int numFra) {
		Factura factFus = this.facturaFusionada(cliente, numFra);
		Factura factFusResumida = new Factura(numFra, cliente, 0);
		for (int i = 0; i < factFus.gettLineas().length; i++) {
			for (int j = 0; j < factFusResumida.gettLineas().length; j++) {
				if (factFus.gettLineas()[i].equals(factFusResumida.gettLineas()[j])) {
					factFusResumida.gettLineas()[j].cantidad++;
				} else {
					factFusResumida.anadeLinea(factFus.gettLineas()[i]);
				}
			}
		}
		return factFusResumida;
	}

	public float gastoPorCliente(Cliente cliente) {
		float gastoTotal = 0.0f;
		/*
		 * First we are going to summarise all of the client's invoices in a single
		 * invoice, this will be done by going into the invoices table and adding the
		 * tables whose client coincides with ours
		 */
		/*
		 * We're also going to make a placeholder invoice which we will use to dump all
		 * of the invoices we collect
		 */
		Factura facturaDefinitiva = new Factura(0, cliente, 0);
		for (int i = 0; i < tFacturas.length; i++) {
			if (tFacturas[i].getCliente().equals(cliente)) {
				for (int j = 0; j < tFacturas[i].gettLineas().length; j++) {
					facturaDefinitiva.anadeLinea(tFacturas[i].gettLineas()[j]);
				}
			}
		}
		/*
		 * With that done, we just need to extract the total amount of the definitive
		 * invoice, and that's our total
		 */
		gastoTotal = facturaDefinitiva.getImporteTotalFra();
		return gastoTotal;
	}

	public Cliente clienteMayorGasto() {
		Cliente bigShot = new Cliente("00000H", "Spamtom G. Spamtom");
		/*
		 * The reason I call them bigshot is because a bigshot is someone who normally
		 * has a lot of cash
		 */
		/*
		 * Now in all seriousness, to do this, we're going to have to call our last
		 * excercise, to see how much does each client spend, and then, compare it to
		 * our bigShot
		 */
		for (int i = 0; i < tClientes.length; i++) {
			float clientSpending = this.gastoPorCliente(tClientes[i]);
			float bigShotspendings = this.gastoPorCliente(bigShot);
			if (clientSpending > bigShotspendings) {
				bigShot = tClientes[i];
			}
		}
		/* After we go through the whole array we should have our biggest spender */
		return bigShot;
	}


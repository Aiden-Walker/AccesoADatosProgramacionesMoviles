	// b) Carga de modelos desde XML (DOM)
	public int addModelosDeXML(String nombreFichero) {
		int modelsAdded = 0;
		try {
			DocumentBuilderFactory factoryDeDocumentos = DocumentBuilderFactory.newInstance();
			DocumentBuilder constructorDeDocumentos = factoryDeDocumentos.newDocumentBuilder();
			Document documento = constructorDeDocumentos.parse(nombreFichero);
			documento.getDocumentElement().normalize();
			System.out.printf("Root element: %s %n", documento.getDocumentElement().getNodeName());
			NodeList clankers = documento.getElementsByTagName("modelo");
			/*
			 * Clanker es un adjetivo despectivo usado para referirse a las inteligencias
			 * artificiales, lo siento Marta, la IA no me gusta nada, por muchos motivos
			 */
			for (int i = 0; i < clankers.getLength(); i++) {
				Node clankerActual = clankers.item(i);
				if (clankerActual.getNodeType() == Node.ELEMENT_NODE) {
					Element elementoModeloActual = (Element) clankerActual;
					String codigo = elementoModeloActual.getElementsByTagName("codigo").item(0).getTextContent();
					String nombre = elementoModeloActual.getElementsByTagName("nombre").item(0).getTextContent();
					String proveedor = elementoModeloActual.getElementsByTagName("proveedor").item(0).getTextContent();
					ModeloIA modeloActual = new ModeloIA(codigo, nombre, proveedor);
					if (!this.catalogoModelos.containsKey(modeloActual.getCodigo())) {
						this.catalogoModelos.put(modeloActual.getCodigo(), modeloActual);
						modelsAdded++;
					}
				}
			}
		} catch (ParserConfigurationException e) {
			// TODO Auto-generated catch block
			e.printStackTrace();
		} catch (SAXException e) {
			// TODO Auto-generated catch block
			e.printStackTrace();
		} catch (IOException e) {
			// TODO Auto-generated catch block
			e.printStackTrace();
		}
		return modelsAdded; // Implementación pendiente
	}

	// c) // 3. Lectura de archivo de texto plano
	public int addEvaluacionesDeTexto(String nombreFichero) {
		int evaluacionesLeidas = 0;
		File ficheroALeer = new File(nombreFichero);
		try (FileReader fr = new FileReader(ficheroALeer)) {
			BufferedReader br = new BufferedReader(fr);
			String line = br.readLine();
			while (line != null) {
				String[] resultadoSplit = line.split(";");
				double puntuacion = Double.parseDouble(resultadoSplit[2]);
				Evaluacion evaActual = new Evaluacion(resultadoSplit[0], resultadoSplit[1], puntuacion);
				if (this.evaluaciones.add(evaActual)) {
					evaluacionesLeidas++;
				}
				line = br.readLine();
			}
		} catch (FileNotFoundException e) {
			// TODO Auto-generated catch block
			e.printStackTrace();
		} catch (IOException e) {
			// TODO Auto-generated catch block
			e.printStackTrace();
		}
		return evaluacionesLeidas; // Implementación pendiente
	}

	// d) Guardar evaluaciones en binario
	public void escribirEvaluacionesEnBinario(String nombreFichero) {
		// Implementación pendiente
		File lasEvaluacionesBinarioEdition = new File(nombreFichero);
		try (ObjectOutputStream objectOS = new ObjectOutputStream(
				new FileOutputStream(lasEvaluacionesBinarioEdition))) {
			for (Evaluacion clankValuation : this.evaluaciones) {
				objectOS.writeObject(clankValuation);

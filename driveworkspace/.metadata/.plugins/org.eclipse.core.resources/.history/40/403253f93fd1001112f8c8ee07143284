		} catch (FileNotFoundException e) {
			// TODO Auto-generated catch block
			e.printStackTrace();
		} catch (IOException e) {
			// TODO Auto-generated catch block
			e.printStackTrace();
		}
	}

	// e) Leer evaluaciones desde binario
	public ArrayList<Evaluacion> leerEvaluacionesDeBinario(String nombreFichero) {
		File ficheroEvaluaciones = new File(nombreFichero);
		boolean status = ficheroEvaluaciones.exists();
		ArrayList<Evaluacion> listaDeEvaluaciones = new ArrayList<>();
		if (status) {
			try (ObjectInputStream objectIS = new ObjectInputStream(new FileInputStream(ficheroEvaluaciones))) {
				while (true) {
					Evaluacion evaActual = (Evaluacion) objectIS.readObject();
					listaDeEvaluaciones.add(evaActual);
				}
			} catch (FileNotFoundException e) {
				System.out.println("El archivo no se ha encontrado, porfavor intenta otro nombre");
			} catch (EOFException e) {
				System.out.println("El fin del archivo ha sido alcanzado");
			} catch (IOException e) {
				e.printStackTrace();
			} catch (ClassNotFoundException e) {
				// TODO Auto-generated catch block
				e.printStackTrace();
			}
		}
		return listaDeEvaluaciones; // Implementación pendiente
	}


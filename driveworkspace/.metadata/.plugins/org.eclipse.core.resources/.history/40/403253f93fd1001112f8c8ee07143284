public class Modelo {
	private Map<String, ModeloIA> catalogoModelos = new HashMap<>();
	private List<Evaluacion> evaluaciones = new ArrayList<>();

	public Modelo() {
		super();
	}

	public Map<String, ModeloIA> getCatalogoModelos() {
		return catalogoModelos;
	}

	public List<Evaluacion> getEvaluaciones() {
		return evaluaciones;
	}

	public boolean addModeloIA(ModeloIA modelo) {
		if (!catalogoModelos.containsKey(modelo.getCodigo())) {
			catalogoModelos.put(modelo.getCodigo(), modelo);
			return true;
		}
		return false;
	}

	public boolean removeModeloIAByCodigo(String codigo) {
		return catalogoModelos.remove(codigo) != null;
	}

	public void addEvaluacion(Evaluacion evaluacion) {
		evaluaciones.add(evaluacion);
	}

	public int obtenerNumErrores() {
		int numErrores = 0;
		for (Evaluacion ev : evaluaciones) {
			if (!catalogoModelos.containsKey(ev.getCodigoModelo())) {
				numErrores++;
			}
		}
		return numErrores;
	}

	// a) Gestión del log de errores
	public boolean creaArchivoErrores() {
		boolean status = false;

	public void guardaClientesEnTXT(File ficheroClientes) {
		try (BufferedWriter guardaClientesTXT = new BufferedWriter(new FileWriter(ficheroClientes))) {
			for (Reserva re : this.tReservas) {
				guardaClientesTXT.write(re.getCliente().getNombre());
				guardaClientesTXT.newLine();
			}
		} catch (IOException e) {
			// TODO Auto-generated catch block
			e.printStackTrace();
		}

	}

	public boolean cargarReservasDeFicheroBinario(File ficheroReservas) {
		boolean status = false;
		try (ObjectInputStream objectIS = new ObjectInputStream(new FileInputStream(ficheroReservas))) {
			status = true;
			while (true) {
				Reserva reActual = (Reserva) objectIS.readObject();
				System.out.println(reActual);
			}
		} catch (FileNotFoundException e) {
			System.out.println("El archivo no se ha encontrado, porfavor intenta otro nombre");
		} catch (EOFException e) {
			System.out.println("El fin del archivo ha sido alcanzado");
		} catch (IOException e) {
			e.printStackTrace();
		} catch (ClassNotFoundException e) {
			// TODO Auto-generated catch block
			e.printStackTrace();
		}
		return status;
	}

	public void guardarReservasEnFicheroBinario(File ficheroReservas) {
		try (ObjectOutputStream objectOS = new ObjectOutputStream(new FileOutputStream(ficheroReservas))) {
			for (Reserva remake : this.tReservas) {
				objectOS.writeObject(remake);
			}
		} catch (Exception e) {
			// TODO: handle exception
		}
	}

	public void guardarReservasEnFicheroXML(File ficheroXML) {
		Scanner sc = new Scanner(System.in);
		DocumentBuilderFactory teFaltaFabrica = DocumentBuilderFactory.newInstance();
		DocumentBuilder bobElConstructor;

		try {
			bobElConstructor = teFaltaFabrica.newDocumentBuilder();
			DOMImplementation implementacionOG = bobElConstructor.getDOMImplementation();
			Document documentoDeAdecuadoTexto = implementacionOG.createDocument(null, "reservas", null);
			documentoDeAdecuadoTexto.setXmlVersion("1.0");

			for (Reserva reReserva : this.tReservas) {
				Element root /* Raiz en ingles no? */ = documentoDeAdecuadoTexto.createElement("reserva");
				documentoDeAdecuadoTexto.getDocumentElement().appendChild(root);
				/* Añadimos el cliente */
				crearElementoXML("cliente", reReserva.getCliente().getNombre(), root, documentoDeAdecuadoTexto);
				/* Ahora la habitacion */
				crearElementoXML("habitacion", "" + reReserva.getHabitación().getNumero(), root,
						documentoDeAdecuadoTexto);

				crearElementoXML("fechainicio", "", root, documentoDeAdecuadoTexto);
				crearElementoXML("dia", "" + reReserva.getFechaInicio().getDia(), root, documentoDeAdecuadoTexto);
				crearElementoXML("mes", "" + reReserva.getFechaInicio().getMes(), root, documentoDeAdecuadoTexto);
				crearElementoXML("anyo", "" + reReserva.getFechaInicio().getAnyo(), root, documentoDeAdecuadoTexto);

				crearElementoXML("fechafin", "", root, documentoDeAdecuadoTexto);
				crearElementoXML("dia", "" + reReserva.getFechaFin().getDia(), root, documentoDeAdecuadoTexto);
				crearElementoXML("mes", "" + reReserva.getFechaFin().getMes(), root, documentoDeAdecuadoTexto);
				crearElementoXML("anyo", "" + reReserva.getFechaFin().getAnyo(), root, documentoDeAdecuadoTexto);
			}
			Source fuente = new DOMSource(documentoDeAdecuadoTexto);
			Result resultado = new StreamResult(new java.io.File(ficheroXML.toString()));
			Transformer transformador = TransformerFactory.newInstance().newTransformer();
			transformador.transform(fuente, resultado);
		} catch (ParserConfigurationException e) {
			// TODO Auto-generated catch block
			e.printStackTrace();
		} catch (TransformerConfigurationException e) {
			e.printStackTrace();
		} catch (TransformerFactoryConfigurationError e) {

		} catch (TransformerException e) {
			// TODO Auto-generated catch block
			e.printStackTrace();
		}

	}

	public void crearElementoXML(String datoAmeter, String funValue, Element rooty, Document documentito) {
		/*
		 * De verdad que siento las graciosadas por ejemplo en los nombres de las cosas
		 * pero es que la cabeza me va a reventar
		 */
		Element elementomori = documentito.createElement(datoAmeter);
		Text muchoTexto = documentito.createTextNode(funValue);
		rooty.appendChild(elementomori);
		elementomori.appendChild(muchoTexto);
	}


public class Texto {
	private String cadena;
	private int longitudMaxima;

	/**
	 * @return the cadena
	 */
	public String getCadena() {
		return cadena;
	}

	/**
	 * @param cadena the cadena to set
	 */
	public void setCadena(String cadena) {

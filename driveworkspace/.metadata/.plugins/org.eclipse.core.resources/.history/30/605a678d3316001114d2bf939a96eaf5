/*En verdad podria utilizar este programa para buscar a los gatos con un simple cambio, un string que sea "animal a buscar", lo cual me permitiria reutilizar la clase entera para los gatos, esto locked in*/
public class BuscaAnimales extends Process {
	File whatTheDogDoin;
	FileReader collectMyFiles;
	FileWriter writeMyFiles;
	BufferedReader buscandoUnosPerros;
	int numDogs;
	String animalAbuscar;

	public BuscaAnimales(File whatTheDogDoin, FileReader collectMyFiles, FileWriter writeMyFiles,
			BufferedReader buscandoUnosPerros, int numDogs, String animalAbuscar) {
		super();
		this.whatTheDogDoin = whatTheDogDoin;
		this.collectMyFiles = collectMyFiles;
		this.writeMyFiles = writeMyFiles;
		this.buscandoUnosPerros = buscandoUnosPerros;
		this.numDogs = numDogs;
		this.animalAbuscar = animalAbuscar;
	}

	/*
	 * Primer aviso de que todo el codigo se reutiliza para buscar, gatos, en base a
	 * la linea de animal a buscar Si tuviera que renombrar todos los atributos y
	 * metodos me llevaria un rato, y debo aprovechar el tiempo
	 */
	public Process buscaAnimalesProcess() {
		ProcessBuilder pb;
		Process trust = null;
		try {
			pb = new ProcessBuilder("java", "-jar", "BuscaPerros.jar");
			trust = pb.start();
		} catch (Exception e) {
			// TODO: handle exception
		}
		return trust;

	}

	public void start() throws IOException {
		System.out.println("Buscando " + animalAbuscar + "s");
		while (buscandoUnosPerros.readLine() != null) {
			String lineaPerruna = buscandoUnosPerros.readLine();
			if (lineaPerruna.toLowerCase().contains(animalAbuscar)) {
				writeMyFiles.write(lineaPerruna);
				numDogs++;
			}
		}
		System.out.println("Numero de " + animalAbuscar + "s " + numDogs);
	}


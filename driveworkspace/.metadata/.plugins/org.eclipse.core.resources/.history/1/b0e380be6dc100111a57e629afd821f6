package FicherosBinarios;

import java.io.*;
import java.util.Scanner;

public class Ejercicio6FicherosBinarios {

	public static void main(String[] args) throws IOException, ClassNotFoundException {
		Pedido p1 = new Pedido("Skibidis", 3, 10);
		Pedido p2 = new Pedido("Salsa", 5, 5.99);
		Pedido p3 = new Pedido("Macarrones", 10, 2.49);
		Pedido[] listaPedidos = new Pedido[3];
		listaPedidos[0] = p1;
		listaPedidos[1] = p2;
		listaPedidos[2] = p3;
		Scanner sc = new Scanner(System.in);
		System.out.println("Escribe el nombre del fichero que se va a escribir");
		String nombreFichero = sc.next();
		sc.close();
		Ejercicio6FicherosBinarios.escribirPedidos(listaPedidos, nombreFichero);
		Ejercicio6FicherosBinarios.leerPedidos(nombreFichero);
	}

	public static void escribirPedidos(Pedido[] pedidos, String nomFichero) {
		File fichPedidos = new File(nomFichero);
		ObjectOutputStream objectOS = new ObjectOutputStream(new FileOutputStream(fichPedidos));
		for (Pedido pedido : pedidos) {
			objectOS.writeObject(pedido);
		}
	}

	public static void leerPedidos(String nomFichero)
		try (ObjectInputStream objectIS = new ObjectInputStream(new FileInputStream(nomFichero))) {
			while (true) {
				Pedido pedActual = (Pedido) objectIS.readObject();
				System.out.println(pedActual);
			}
		}
	}
}

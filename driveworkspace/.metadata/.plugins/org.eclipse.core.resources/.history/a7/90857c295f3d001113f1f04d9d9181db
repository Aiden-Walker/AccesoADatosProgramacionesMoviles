	protected void botonGuardarPulsado() {
		if (this.textFieldNomPok.getText().isEmpty()) {
			this.error("Debe escribir un nombre");
		} else {
			String name = this.textFieldNomPok.getText();
			int gen = Integer.parseInt(this.textFieldGenPok.getText());
			if (gen < 1 || gen > 7) {
				this.error("La generacion que ha escrito es invalida");
			} else {
				String evoState = "";
				if (this.radiob1.isSelected()) {
					evoState = "Menor";
				} else if (radiob2.isSelected()) {
					evoState = "Medio";
				} else if (radiob3.isSelected()) {
					evoState = "Mayor";
				} else {
					this.error("No se ha seleccionado ningun estado evolutivo");
				}
				String type = (String) this.comboBoxTipoPok.getSelectedItem();
				Pokemon pokToAdd = new Pokemon(name, type, gen, type);
				if (this.controlador.guardaPokemon(pokToAdd) == true) {
					this.msg("Pokemon Guardado");
					this.limpiaCampos();
					this.actualizaTodosCombos();
				} else {
					this.error("Ese pokemon ya existia");
				}
			}
		}
	}


	public void limpiaCampos() {
		this.textFieldNomPok.setText("");
		this.textFieldGenPok.setText("");
		this.radiob1.setSelected(true);
		this.comboBoxPokABorrar.setSelectedIndex(0);
	}

	public void actualizaTodosCombos() {
		this.actualizaCombo(this.comboBoxPokABorrar);
		this.actualizaCombo(this.comboFight1);
		this.actualizaCombo(this.comboFight2);
	}

	public void actualizaCombo(JComboBox<String> combo) {
		combo.removeAllItems();
		for (Pokemon pokemon : this.controlador.getListaPokemons()) {
			combo.addItem(pokemon.getNombre());
		}
